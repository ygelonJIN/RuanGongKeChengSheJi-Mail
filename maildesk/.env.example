# MailDesk environment template
# Copy this file to `.env` for local development.

# App runtime
NODE_ENV=development
APP_ENV=development
APP_NAME=MailDesk
APP_PORT=5173
APP_HOST=0.0.0.0
APP_URL=http://localhost:5173

# Electron / Vite
VITE_DEV_SERVER_URL=http://localhost:5173
ELECTRON_DISABLE_SECURITY_WARNINGS=true
ELECTRON_ENABLE_LOGGING=true
ELECTRON_SKIP_BINARY_DOWNLOAD=1

# Logging
LOG_LEVEL=debug

# Data storage
# In the current app, SQLite data is stored by the app itself.
# Use a project-local path when you want data to stay with the repo.
APP_DATA_DIR=./data
SQLITE_DB_PATH=./data/maildesk.db

# Optional mail / sync defaults
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM=
MAIL_REPLY_TO=

# OAuth / integrations placeholders
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# UI / locale
LOCALE=zh-CN
THEME=system
